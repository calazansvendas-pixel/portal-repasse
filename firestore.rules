rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function meuPerfil() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function minhaRole() {
      return meuPerfil().role;
    }

    function papelGestor() {
      // gerencia, coordenador e analista enxergam a operação inteira (cada um dentro
      // do seu próprio escopo de telas — a UI já filtra o que cada um pode ver).
      return logado() && minhaRole() in ['gerencia', 'coordenador', 'analista'];
    }

    function souGerencia() {
      // Exclusão de importação (snapshot + tarefas + resumo) é ação exclusiva da Gerência.
      return logado() && minhaRole() == 'gerencia';
    }

    // --- users: cada um lê o próprio perfil; escrita só via Admin SDK/console. ---
    match /users/{uid} {
      allow read: if logado() && (request.auth.uid == uid || papelGestor());
      allow write: if false;
    }

    // --- registros (+ snapshots): importados/atualizados só pelo motor de auditoria
    // (API route com Admin SDK). Leitura para quem acompanha a operação completa. ---
    match /registros/{numero} {
      allow read: if papelGestor();
      allow create, update: if false;
      allow delete: if souGerencia(); // exclusão de importação — ver /api/importacoes/[id]

      match /snapshots/{importacaoId} {
        allow read: if papelGestor();
        allow create, update: if false; // só o motor de auditoria (Admin SDK) grava snapshots
        allow delete: if souGerencia(); // exclusão de importação — ver /api/importacoes/[id]
      }
    }

    // --- importacoes: histórico de uploads. Leitura para gestores; exclusão só Gerência. ---
    match /importacoes/{importacaoId} {
      allow read: if papelGestor();
      allow create, update: if false;
      allow delete: if souGerencia();
    }

    // --- notificacoes: alertas de falha de auditoria. ---
    match /notificacoes/{notifId} {
      allow read: if papelGestor();
      allow write: if false;
    }

    // --- tarefas: o campo "praca" guarda o Quadro (regional OU "coordenador"/"analista"
    // nativo). Cada um só marca/desmarca o checkbox no PRÓPRIO quadro — assistente na sua
    // praça, Coordenador em "coordenador", Analista em "analista". Gerência só observa. ---
    function meuQuadro() {
      return minhaRole() == 'assistente' ? meuPerfil().praca : minhaRole();
    }

    function souDonoDoQuadro(quadroDaTarefa) {
      return minhaRole() in ['assistente', 'coordenador', 'analista'] && quadroDaTarefa == meuQuadro();
    }

    match /tarefas/{tarefaId} {
      allow read: if papelGestor() || (logado() && souDonoDoQuadro(resource.data.praca));

      allow create: if false; // só o motor de auditoria cria tarefas
      allow delete: if souGerencia(); // exclusão de importação — ver /api/importacoes/[id]

      // Dono do quadro: conclui/desfaz a própria tarefa (com nota de conclusão).
      // Gerência/Coordenador/Analista: auditoria humana — só podem DEVOLVER uma
      // tarefa de assistente para "pendente" (nunca concluir nem editar outros campos).
      allow update: if logado() && (
        (souDonoDoQuadro(resource.data.praca) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['status', 'resolvidoPor', 'resolvidoEm', 'etapaNoMomentoResolucao',
             'observacaoNoMomentoResolucao', 'notaResolucao']
          )) ||
        (papelGestor() &&
          resource.data.praca in ['laiza', 'eliane', 'catarina'] &&
          resource.data.status in ['pending_validation', 'validated_done'] &&
          request.resource.data.status == 'pendente' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['status', 'resolvidoPor', 'resolvidoEm', 'etapaNoMomentoResolucao',
             'observacaoNoMomentoResolucao', 'notaResolucao']
          ))
      );
    }
  }
}
