# Copie este arquivo para ".env.local" (nunca commitar o .env.local) e preencha
# com os valores do seu projeto Firebase.
#
# Onde encontrar:
# - NEXT_PUBLIC_FIREBASE_*  -> Console Firebase > Configurações do projeto > Geral >
#   "Seus apps" > app Web > Config do SDK.
# - FIREBASE_ADMIN_*        -> Console Firebase > Configurações do projeto > Contas de
#   serviço > "Gerar nova chave privada" (baixa um JSON). Copie os 3 campos abaixo
#   do JSON gerado. NÃO commite o JSON no repositório.

# --- Firebase Client SDK (público, usado no browser) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (privado, usado só no servidor: API routes) ---
# project_id do JSON da service account
FIREBASE_ADMIN_PROJECT_ID=
# client_email do JSON da service account
FIREBASE_ADMIN_CLIENT_EMAIL=
# private_key do JSON da service account. Cole o valor inteiro entre aspas,
# mantendo os "\n" literais (não quebre linhas de verdade).
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
